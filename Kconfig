menu "Graphics Libraries Configuration"
    config GRAPHIC_UI_MENU
        bool "Enable Graphics UI"
        select GRAPHIC_UI if WHC_HOST || WHC_NONE
        help
            Enable entire UI module. If disabled, none of the UI components will be compiled.
            UI is only built on the WHC host core, or the single core.

    if GRAPHIC_UI_MENU
        rsource "LVGL/Kconfig"
        orsource "frameworks/Kconfig"
        rsource "display/Kconfig"
        rsource "input/Kconfig"
        rsource "third_party/Kconfig"
    endif
endmenu

