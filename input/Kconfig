menu "Touch Controller Selection"
    config TOUCH_ENABLE
        bool "Enable Touch Screen"
        default n
        help
            Enable touchscreen support.
            When disabled, no touch controller is compiled in.

    if TOUCH_ENABLE
        choice
            prompt "Select Touch Controller"
            default TOUCH_GT911_MENU if PANEL_TOUCH_GT911
            default TOUCH_CST328_MENU
            config TOUCH_CST328_MENU
                bool "CST328"
                select TOUCH_CST328

            config TOUCH_GT911_MENU
                bool "GT911"
                select TOUCH_GT911

            config TOUCH_GT9XX_MENU
                bool "GT9XX"
                select TOUCH_GT9XX

            config TOUCH_TDDI_MENU
                bool "TDDI"
                select TOUCH_TDDI
        endchoice

        if TOUCH_GT911
            config TOUCH_SWAP_XY
                bool "Swap touch X/Y"
                default n
                help
                    Set by how the touch panel is mounted, not by the display panel.

            config TOUCH_INVERT_X
                bool "Invert touch X"

            config TOUCH_INVERT_Y
                bool "Invert touch Y"
        endif
    endif
endmenu

config TOUCH_CST328
    bool

config TOUCH_GT911
    bool

config TOUCH_GT9XX
    bool

config TOUCH_TDDI
    bool
