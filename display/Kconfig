menu "Panel Selection"
    choice
        prompt "Select Panel"
        default ST7701S_MENU
        config ST7102_MIPI_MENU
            bool "St7102_mipi"
            select ST7102_MIPI

        config ST7701S_MIPI_MENU
            bool "St7701s_mipi"
            select ST7701S_MIPI
            select TOUCH_ENABLE
            select TOUCH_CST328

        config ST7701S_MENU
            bool "St7701s"
            select ST7701S

        config ST7701S_RGB565_MENU
            bool "St7701s_rgb565"
            select ST7701S_RGB565

        config ST7701P_RGB_MENU
            bool "St7701p_rgb"
            select ST7701P_RGB

        config HJ3508_12_MENU
            bool "Hj3508_12"
            select HJ3508_12

        config B1620A_MENU
            bool "B1620A"
            select B1620A

        config T1720A_MENU
            bool "T1720A"
            select T1720A

        config JD9165BA_MENU
            bool "JD9165BA"
            select JD9165BA

        config AXS15260_MIPI_MENU
            bool "AXS15260_mipi"
            select AXS15260_MIPI

        config GH7002_MENU
            select TOUCH_ENABLE
            select TOUCH_GT9XX
            bool "Gh7002"
            select GH7002
    endchoice
endmenu

